{
    "name": "endurance/route-kml",
    "description": "KML path interpretation for immutable Route revisions",
    "type": "library",
    "license": "MPL-2.0",
    "require": {
        "php": "^8.5",
        "endurance/foundation": "^0.2.0",
        "endurance/geo": "^0.2.0",
        "endurance/kml": "^0.2.0",
        "endurance/route": "^0.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Endurance\\RouteKml\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Endurance\\RouteKml\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "check": [
            "@composer validate --strict",
            "@test"
        ]
    }
}
